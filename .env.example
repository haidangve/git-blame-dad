# Copy to .env.local. Leave the Supabase pair unset to run the game guest-only,
# with no accounts and no Hall of Blame, exactly like the hackathon build.

# From `npx supabase start` locally (API URL + anon key), or from your
# Supabase project's Settings → API page in production.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute URL of the site, for link previews (Open Graph images).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OAuth buttons to show on /login, comma-separated: github, google, discord.
# Each one must also be switched on in Supabase → Authentication → Providers.
# Email magic links always work and need no setup.
NEXT_PUBLIC_AUTH_PROVIDERS=
